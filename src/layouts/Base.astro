---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import LocalizedWidgetArea from "../components/LocalizedWidgetArea.astro";
import {
	DEFAULT_LOCALE,
	LOCALES,
	LOCALE_CODES,
	getTranslator,
	getLocale,
	localePath,
	localizeUrl,
	type Locale,
} from "../i18n";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/**
	 * Published translations of this page, as site paths per locale. Drives the
	 * language switcher and `hreflang` links. Omit it on pages that exist in
	 * every locale under the same path (archives, search, 404).
	 */
	alternates?: Partial<Record<Locale, string>>;
	/** Override the locale taken from the URL (the 404 page is rewritten to a locale-less path). */
	locale?: Locale;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
	alternates,
} = Astro.props;
const locale = Astro.props.locale ?? getLocale(Astro);
const t = await getTranslator(Astro, locale);
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary", { locale }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
	locale,
	t,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;
const homeHref = localePath(locale, "/");
const menuItems = (menu?.items ?? []).map((item) => ({
	...item,
	// Menu URLs carry no locale prefix; add it for root-relative links.
	url: localizeUrl(locale, item.url),
}));
const hasHomeInMenu = menuItems.some(
	(item) => item.url === homeHref || item.url === "/" || item.url === "",
);
const mobileMenuItems = hasHomeInMenu
	? menuItems
	: [{ label: t("nav.home"), url: homeHref, target: undefined }, ...menuItems];
const searchHref = localePath(locale, "/search");
const rssHref = localePath(locale, "/rss.xml");

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;

const TRAILING_SLASH = /\/$/;
const currentPath = Astro.url.pathname.replace(TRAILING_SLASH, "") || "/";

/** "page" for the current page, "true" for its parent section (e.g. Posts on a post). */
function navCurrent(url: string): "page" | "true" | undefined {
	let target: URL;
	try {
		target = new URL(url, Astro.url);
	} catch {
		return undefined;
	}
	if (target.origin !== Astro.url.origin || target.hash) return undefined;
	if (target.search && target.search !== Astro.url.search) return undefined;
	const path = target.pathname.replace(TRAILING_SLASH, "") || "/";
	if (path === currentPath) return "page";
	// The home link (`/` or `/zh-TW`) is a prefix of every page; never a parent.
	const isHome = path === "/" || path === homeHref.replace(TRAILING_SLASH, "");
	if (!isHome && currentPath.startsWith(`${path}/`)) return "true";
	return undefined;
}

const lang = LOCALES[locale].htmlLang;

// Language switcher + hreflang. Content pages pass `alternates` (only locales
// with a published translation); everything else maps to the same path.
const LEADING_LOCALE = new RegExp(`^/(${LOCALE_CODES.join("|")})(?=/|$)`);
const unprefixedPath = Astro.url.pathname.replace(LEADING_LOCALE, "") || "/";
const sharedSearch = unprefixedPath === "/search" ? Astro.url.search : "";
const localeLinks = LOCALE_CODES.flatMap((code) => {
	const href = alternates
		? alternates[code]
		: localePath(code, unprefixedPath) + sharedSearch;
	return href ? [{ code, href, ...LOCALES[code] }] : [];
});
const hreflangLinks = localeLinks.map((link) => ({
	hreflang: link.code,
	href: new URL(link.href, Astro.url.origin).href,
}));
const defaultLink = localeLinks.find((link) => link.code === DEFAULT_LOCALE);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href={rssHref}
		/>
		{
			// EmDashHead already emits hreflang for pages that pass `content`.
			!content &&
				localeLinks.length > 1 &&
				hreflangLinks.map((link) => (
					<link rel="alternate" hreflang={link.hreflang} href={link.href} />
				))
		}
		{
			!content && localeLinks.length > 1 && defaultLink && (
				<link
					rel="alternate"
					hreflang="x-default"
					href={new URL(defaultLink.href, Astro.url.origin).href}
				/>
			)
		}
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				document.documentElement.classList.add("js");
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body data-emdash-editor={isLoggedIn ? "" : undefined}>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">{t("a11y.skip")}</a>
		<header class="site-header">
			<div class="frame site-header__inner">
				<a href={homeHref} class="brand">
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								class="brand__logo"
							/>
						) : (
							<>
								<span class="brand__name">{siteTitle}</span>
							</>
						)
					}
				</a>
				{
					menuItems.length > 0 && (
						<nav class="site-nav" aria-label={t("nav.main")}>
							<ul>
								{menuItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={
												item.target === "_blank"
													? "noopener noreferrer"
													: undefined
											}
											aria-current={navCurrent(item.url)}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
				<div class="site-header__actions">
					<div class="site-search" role="search" aria-label={t("search.title")}>
						<svg
							class="site-search__icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
							></path></svg
						>
						<LiveSearch
							placeholder={t("search.placeholder")}
							searchPage={searchHref}
							class="site-search__field"
							inputClass="site-search-input"
							resultsClass="site-search-results"
							resultClass="site-search-result"
							collections={["posts", "pages", "news"]}
							routeMap={{ news: localePath(locale, "/news") }}
						>
							<span slot="loading">{t("search.loading")}</span>
							<span slot="no-results">{t("search.noResultsLive")}</span>
						</LiveSearch>
						<kbd class="site-search__kbd" aria-hidden="true"
							><span dir="ltr">⌘K</span></kbd
						>
					</div>
					{
						localeLinks.length > 1 && (
							<nav class="lang-switch" aria-label={t("lang.switch")}>
								{localeLinks.map((link) => (
									<a
										href={link.href}
										lang={link.htmlLang}
										hreflang={link.htmlLang}
										aria-current={link.code === locale ? "true" : undefined}
										title={link.label}
									>
										{link.short}
									</a>
								))}
							</nav>
						)
					}
					<a
						href={searchHref}
						class="icon-btn site-search-link"
						aria-label={t("search.title")}
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
							></path></svg
						>
					</a>
					{
						isLoggedIn && (
							<a href="/_emdash/admin" class="btn btn--ghost btn--sm nav-admin">
								{t("nav.admin")}
							</a>
						)
					}
					<button
						type="button"
						class="mobile-menu-toggle"
						id="mobile-menu-toggle"
						aria-label={t("nav.openMenu")}
						data-label-open={t("nav.openMenu")}
						data-label-close={t("nav.closeMenu")}
						aria-expanded="false"
						aria-controls="mobile-nav-drawer"
					>
						<span class="hamburger-box" aria-hidden="true">
							<span class="hamburger-line line-1"></span>
							<span class="hamburger-line line-2"></span>
							<span class="hamburger-line line-3"></span>
						</span>
					</button>
				</div>
			</div>
		</header>
		<script is:inline>
			// Fit the header to its menu. The menu is edited in the admin and the labels differ
			// per language, so no fixed breakpoint can be right: try the full header, then the
			// compact one (search as an icon, tighter menu), then collapse into the hamburger.
			(function () {
				var root = document.documentElement;
				var inner = document.querySelector(".site-header__inner");
				var nav = document.querySelector(".site-nav");
				if (!inner || !nav) return;
				var lastWidth = -1;
				function fits() {
					return nav.scrollWidth <= nav.clientWidth + 1;
				}
				function update() {
					// Classes are swapped and measured in one go, so no intermediate state is painted
					root.classList.remove("nav-compact", "nav-collapsed");
					if (fits()) return;
					root.classList.add("nav-compact");
					if (fits()) return;
					root.classList.add("nav-collapsed");
				}
				update();
				new ResizeObserver(function () {
					var width = inner.clientWidth;
					if (width === lastWidth) return;
					lastWidth = width;
					update();
				}).observe(inner);
				if (document.fonts && document.fonts.ready) document.fonts.ready.then(update);
				window.addEventListener("load", update);
			})();
		</script>

		<!-- Mobile Navigation Backdrop & Drawer -->
		<div
			class="mobile-nav-backdrop"
			id="mobile-nav-backdrop"
			aria-hidden="true"
		></div>
		<nav
			class="mobile-nav"
			id="mobile-nav-drawer"
			aria-label={t("nav.mobile")}
			aria-hidden="true"
		>
			<div class="mobile-nav__scroller">
				<ul class="mobile-nav__list">
					{
						mobileMenuItems.map((item) => (
							<li class="mobile-nav__item">
								<a
									href={item.url}
									target={item.target}
									rel={
										item.target === "_blank"
											? "noopener noreferrer"
											: undefined
									}
									aria-current={navCurrent(item.url)}
									class="mobile-nav__link"
								>
									<span class="mobile-nav__link-text">{item.label}</span>
									<svg
										class="mobile-nav__link-arrow"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<polyline points="9 18 15 12 9 6" />
									</svg>
								</a>
							</li>
						))
					}
				</ul>

				<div class="mobile-nav__divider"></div>

				<div class="mobile-nav__footer">
					<a
						href={searchHref}
						class="mobile-nav__search-btn"
						aria-label={t("search.mobileLabel")}
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="11" cy="11" r="7"></circle>
							<path d="m20 20-3.5-3.5"></path>
						</svg>
						<span>{t("search.mobile")}</span>
						<kbd class="mobile-nav__search-kbd" aria-hidden="true">⌘K</kbd>
					</a>

					{
						localeLinks.length > 1 && (
							<div class="mobile-nav__theme-row">
								<span class="mobile-nav__theme-label">{t("lang.switch")}</span>
								<nav class="lang-switch" aria-label={t("lang.switch")}>
									{localeLinks.map((link) => (
										<a
											href={link.href}
											lang={link.htmlLang}
											hreflang={link.htmlLang}
											aria-current={link.code === locale ? "true" : undefined}
										>
											{link.label}
										</a>
									))}
								</nav>
							</div>
						)
					}

					<div class="mobile-nav__theme-row">
						<span class="mobile-nav__theme-label">{t("theme.appearance")}</span>
						<div
							class="theme-switcher"
							role="group"
							aria-label={t("theme.group")}
						>
							<button
								type="button"
								class="theme-btn"
								data-theme="light"
								aria-label={t("theme.light")}
							>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									><circle cx="12" cy="12" r="4"></circle><path
										d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
									></path></svg
								>
							</button>
							<button
								type="button"
								class="theme-btn"
								data-theme="dark"
								aria-label={t("theme.dark")}
							>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									><path
										d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
									></path></svg
								>
							</button>
							<button
								type="button"
								class="theme-btn"
								data-theme="system"
								aria-label={t("theme.system")}
							>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									><rect x="2" y="3" width="20" height="14" rx="2"></rect><path
										d="M8 21h8M12 17v4"></path></svg
								>
							</button>
						</div>
					</div>

					{
						isLoggedIn && (
							<div class="mobile-nav__admin-row">
								<a
									href="/_emdash/admin"
									class="btn btn--ghost btn--sm mobile-nav__admin-btn"
								>
									{t("nav.adminDashboard")}
								</a>
							</div>
						)
					}
				</div>
			</div>
		</nav>
		<script is:inline>
			// Inline, so the height is set before the browser scrolls to a URL fragment
			(function () {
				var header = document.querySelector(".site-header");
				function setHeight() {
					document.documentElement.style.setProperty(
						"--header-height",
						header.offsetHeight + "px",
					);
				}
				setHeight();
				new ResizeObserver(setHeight).observe(header);
			})();
		</script>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer band">
			<div class="frame site-footer__grid">
				<div class="site-footer__brand">
					<a href={homeHref} class="brand">
						{
							siteLogo ? (
								<img
									src={siteLogo.url}
									alt={siteLogo.alt || siteTitle}
									class="brand__logo"
								/>
							) : (
								<>
									<span class="brand__name">{siteTitle}</span>
								</>
							)
						}
					</a>
					{siteTagline && <p class="site-footer__tagline">{siteTagline}</p>}
				</div>
				{
					menuItems.length > 0 && (
						<nav class="site-footer__col" aria-labelledby="footer-navigate">
							<h2 id="footer-navigate" class="eyebrow">
								{t("footer.navigate")}
							</h2>
							<ul class="site-footer__links">
								{menuItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={
												item.target === "_blank"
													? "noopener noreferrer"
													: undefined
											}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
				<div class="site-footer__col">
					<h2 class="eyebrow">{t("footer.connect")}</h2>
					<ul class="site-footer__links">
						<li>
							<a href={rssHref}>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									><path d="M4 11a9 9 0 0 1 9 9"></path><path
										d="M4 4a16 16 0 0 1 16 16"></path><circle
										cx="5"
										cy="19"
										r="1"></circle></svg
								>
								{t("footer.rss")}
							</a>
						</li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__widgets">
					<LocalizedWidgetArea name="footer" />
				</div>
			</div>
			<div class="band site-footer__bottom">
				<div class="frame site-footer__bottom-inner">
					<p class="site-footer__meta">
						{t("footer.rights", { year, title: siteTitle })}
					</p>
					<div class="theme-switcher" role="group" aria-label={t("theme.group")}>
						<button
							type="button"
							class="theme-btn"
							data-theme="light"
							aria-label={t("theme.light")}
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><circle cx="12" cy="12" r="4"></circle><path
									d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="dark"
							aria-label={t("theme.dark")}
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><path
									d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="system"
							aria-label={t("theme.system")}
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><rect x="2" y="3" width="20" height="14" rx="2"></rect><path
									d="M8 21h8M12 17v4"></path></svg
							>
						</button>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Theme switcher
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000,
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
