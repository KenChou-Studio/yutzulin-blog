				order: 2;
				font-size: var(--font-size-sm);
				font-weight: 500;
			}

			.site-search :global(.emdash-live-search-result-collection) {
				order: 1;
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: var(--tracking-wider);
				text-transform: uppercase;
				color: var(--color-muted);
			}

			.site-search :global(.emdash-live-search-result-snippet) {
				order: 3;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				font-size: var(--font-size-xs);
				line-height: var(--leading-snug);
				color: var(--color-text-secondary);
			}

			.site-search :global(.emdash-live-search-result-snippet mark) {
				padding: 0 2px;
				border-radius: 3px;
				background: var(--color-fill-strong);
				color: var(--color-text);
			}

			.site-search-link {
				display: none;
			}

			/* Mobile Menu Toggle Button (Desktop hidden) */
			.mobile-menu-toggle {
				display: none;
				align-items: center;
				justify-content: center;
				width: 2.75rem;
				height: 2.75rem;
				padding: 0;
				border: 1px solid var(--color-border);
				border-radius: var(--radius-full);
				background: var(--color-surface);
				color: var(--color-text);
				cursor: pointer;
				transition:
					background-color var(--transition-fast),
					border-color var(--transition-fast),
					color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			.mobile-menu-toggle:hover {
				background: var(--color-fill);
				border-color: var(--color-border-strong);
				color: var(--color-accent, var(--color-brand));
			}

			.mobile-menu-toggle:focus-visible {
				outline: 2px solid var(--color-accent, var(--color-brand));
				outline-offset: 2px;
			}

			.mobile-menu-toggle.is-active {
				background: var(--color-fill);
				border-color: var(--color-accent, var(--color-brand));
				color: var(--color-accent, var(--color-brand));
			}

			.hamburger-box {
				position: relative;
				width: 18px;
				height: 14px;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			.hamburger-line {
				display: block;
				width: 100%;
				height: 2px;
				border-radius: 1px;
				background-color: currentColor;
				transition:
					transform 240ms var(--ease-out),
					opacity 180ms ease,
					background-color var(--transition-fast);
				transform-origin: center;
			}

			.mobile-menu-toggle.is-active .line-1 {
				transform: translateY(6px) rotate(45deg);
			}

			.mobile-menu-toggle.is-active .line-2 {
				opacity: 0;
				transform: scaleX(0);
			}

			.mobile-menu-toggle.is-active .line-3 {
				transform: translateY(-6px) rotate(-45deg);
			}

			/* Mobile Navigation Backdrop & Drawer Base (Desktop hidden) */
			.mobile-nav-backdrop {
				display: none;
			}

			.mobile-nav {
				display: none;
			}

			/* Footer */
			.site-footer__grid {
				display: grid;
				grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
				gap: var(--spacing-10);
				padding-block: var(--spacing-16) var(--spacing-12);
			}

			.site-footer__tagline {
				margin-top: var(--spacing-4);
				max-width: 34ch;
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
			}

			.site-footer__col .eyebrow,
			.site-footer__widgets :global(.widget__title) {
				margin-bottom: var(--spacing-4);
			}

			.site-footer__links {
				display: grid;
				gap: var(--spacing-3);
				list-style: none;
			}

			.site-footer__links a {
				display: inline-flex;
				align-items: center;
				gap: var(--spacing-2);
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
				text-decoration: none;
			}

			.site-footer__links a:hover {
				color: var(--color-text);
			}

			.site-footer__links svg {
				width: 15px;
				height: 15px;
			}

			.site-footer__widgets :global(.widget-area) {
				display: grid;
				gap: var(--spacing-8);
			}

			.site-footer__widgets :global(.widget__title) {
				font-family: var(--font-mono);
				font-size: var(--font-size-label);
				font-weight: 500;
				letter-spacing: var(--tracking-wider);
				text-transform: uppercase;
				color: var(--color-muted);
			}

			.site-footer__widgets :global(.widget__content) {
				font-size: var(--font-size-sm);
				line-height: var(--leading-relaxed);
				color: var(--color-text-secondary);
			}

			.site-footer__widgets :global(.widget__content ul) {
				display: grid;
				gap: var(--spacing-3);
				list-style: none;
			}

			.site-footer__bottom-inner {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: var(--spacing-4);
				padding-block: var(--spacing-5);
			}

			.site-footer__meta {
				font-size: var(--font-size-xs);
				color: var(--color-muted);
			}

			.site-footer__meta a {
				color: var(--color-text-secondary);
			}

			.theme-switcher {
				display: inline-flex;
				gap: 2px;
				padding: 3px;
				border-radius: var(--radius-full);
				background: var(--color-fill);
			}

			.theme-btn {
				display: grid;
				place-items: center;
				width: 1.75rem;
				height: 1.75rem;
				padding: 0;
				border: 0;
				border-radius: var(--radius-full);
				background: transparent;
				color: var(--color-muted);
				cursor: pointer;
				transition:
					color var(--transition-fast),
					background-color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			.theme-btn:hover {
				color: var(--color-text);
			}

			.theme-btn.active {
				background: var(--color-surface);
				color: var(--color-text);
				box-shadow:
					0 0 0 1px var(--color-ring),
					var(--shadow-sm);
			}

			.theme-btn svg {
				width: 15px;
				height: 15px;
			}

			@media (forced-colors: active) {
				.site-nav a[aria-current],
				.mobile-nav__link[aria-current],
				.mobile-menu-toggle,
				.theme-btn.active {
					border: 1px solid CanvasText;
				}
			}

			@media (max-width: 900px) {
				.site-footer__grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: var(--spacing-8);
					padding-block: var(--spacing-12) var(--spacing-10);
				}

				.site-footer__brand {
					grid-column: 1 / -1;
				}
			}

			/* Mid-width screens (821px - 1040px): keep desktop nav compact */
			/* Compact header: tried before collapsing — the search field becomes an icon
			 * and the menu tightens up. */
			html.nav-compact .site-header__inner {
				gap: var(--spacing-3);
			}

			html.nav-compact .site-nav a {
				padding: 6px 8px;
			}

			html.nav-compact .site-search {
				display: none;
			}

			html.nav-compact .site-search-link {
				display: inline-grid;
			}

			/* Collapsed header: a hamburger and a drawer replace the inline menu.
			 * Set by the script after the header (src/layouts/Base.astro) as soon as the
			 * menu no longer fits on one line, whatever the language or number of items. */
			html.nav-collapsed .site-header {
					position: sticky;
					top: 0;
					z-index: 95;
				}

				html.nav-collapsed .site-header__inner {
					flex-wrap: nowrap;
					justify-content: space-between;
					gap: var(--spacing-3);
				}

				html.nav-collapsed .site-nav {
					display: none !important;
				}

				html.nav-collapsed .site-search {
					display: none !important;
				}

				html.nav-collapsed .site-header__actions .nav-admin {
					display: none !important;
				}

				html.nav-collapsed .site-search-link {
					display: inline-grid !important;
					width: 2.75rem;
					height: 2.75rem;
				}

				html.nav-collapsed .mobile-menu-toggle {
					display: inline-flex !important;
				}

				/* Mobile Backdrop */
				html.nav-collapsed .mobile-nav-backdrop {
					display: block;
					position: fixed;
					inset: 0;
					top: var(--header-height, 64px);
					z-index: 85;
					background: color-mix(
						in srgb,
						var(--color-bg) 60%,
						rgba(0, 0, 0, 0.45)
					);
					backdrop-filter: blur(8px);
					-webkit-backdrop-filter: blur(8px);
					opacity: 0;
					visibility: hidden;
					pointer-events: none;
					transition:
						opacity 250ms var(--ease-out),
						visibility 250ms var(--ease-out);
				}

				html.nav-collapsed .mobile-nav-backdrop.is-open {
					opacity: 1;
					visibility: visible;
					pointer-events: auto;
				}

				/* Mobile Drawer */
				html.nav-collapsed .mobile-nav {
					display: flex;
					flex-direction: column;
					position: fixed;
					top: var(--header-height, 64px);
					inset-inline: 0;
					bottom: 0;
					z-index: 90;
					background: var(--color-surface);
					border-top: 1px solid var(--color-border);
					box-shadow: 0 20px 30px -10px var(--color-shadow-strong);
					opacity: 0;
					visibility: hidden;
					pointer-events: none;
					transform: translateY(-12px);
					transition:
						transform 250ms var(--ease-out),
						opacity 250ms var(--ease-out),
						visibility 250ms var(--ease-out);
				}

				html.nav-collapsed .mobile-nav.is-open {
					opacity: 1;
					visibility: visible;
					pointer-events: auto;
					transform: translateY(0);
				}

				html.nav-collapsed .mobile-nav__scroller {
					flex: 1;
					overflow-y: auto;
					-webkit-overflow-scrolling: touch;
					overscroll-behavior: contain;
					padding: var(--spacing-4) var(--frame-padding)
						max(var(--spacing-8), env(safe-area-inset-bottom, 24px));
					display: flex;
					flex-direction: column;
					gap: var(--spacing-4);
				}

				html.nav-collapsed .mobile-nav__list {
					display: flex;
					flex-direction: column;
					gap: 4px;
					list-style: none;
					padding: 0;
					margin: 0;
				}

				html.nav-collapsed .mobile-nav__link {
					display: flex;
					align-items: center;
					justify-content: space-between;
					min-height: 48px;
					padding: 12px 16px;
					border-radius: var(--radius-lg);
					font-size: var(--font-size-base);
					font-weight: 500;
					color: var(--color-text);
					text-decoration: none;
					transition:
						background-color var(--transition-fast),
						color var(--transition-fast),
						transform var(--transition-fast);
				}

				html.nav-collapsed .mobile-nav__link:hover {
					background: var(--color-fill);
					color: var(--color-accent, var(--color-brand));
				}

				html.nav-collapsed .mobile-nav__link[aria-current] {
					color: var(--color-accent, var(--color-brand));
					background: var(--color-fill);
					font-weight: 600;
				}

				html.nav-collapsed .mobile-nav__link[aria-current="page"] {
					background: var(--color-fill-strong);
				}

				html.nav-collapsed .mobile-nav__link-arrow {
					width: 16px;
					height: 16px;
					color: var(--color-muted);
					transition: transform var(--transition-fast);
				}

				html.nav-collapsed .mobile-nav__link:hover .mobile-nav__link-arrow {
					transform: translateX(3px);
					color: var(--color-text);
				}

				html.nav-collapsed .mobile-nav__divider {
					height: 1px;
					background: var(--color-border);
					margin-block: var(--spacing-2);
				}

				html.nav-collapsed .mobile-nav__footer {
					display: flex;
					flex-direction: column;
					gap: var(--spacing-3);
				}

				html.nav-collapsed .mobile-nav__search-btn {
					display: flex;
					align-items: center;
					gap: var(--spacing-3);
					padding: 11px 16px;
					border-radius: var(--radius-full);
					background: var(--color-fill);
					border: 1px solid var(--color-border);
					color: var(--color-text-secondary);
					font-size: var(--font-size-sm);
					text-decoration: none;
					transition:
						background-color var(--transition-fast),
						border-color var(--transition-fast),
						color var(--transition-fast);
				}

				html.nav-collapsed .mobile-nav__search-btn:hover {
					background: var(--color-surface);
					border-color: var(--color-border-strong);
					color: var(--color-text);
				}

				html.nav-collapsed .mobile-nav__search-btn svg {
					width: 18px;
					height: 18px;
					color: var(--color-muted);
					flex-shrink: 0;
				}

				html.nav-collapsed .mobile-nav__search-kbd {
					margin-inline-start: auto;
					padding: 2px 6px;
					border-radius: var(--radius-sm);
					background: var(--color-surface);
					border: 1px solid var(--color-border);
					font-family: var(--font-mono);
					font-size: 11px;
					color: var(--color-muted);
				}

				html.nav-collapsed .mobile-nav__theme-row {
					display: flex;
					align-items: center;
					justify-content: space-between;
					padding: var(--spacing-2) var(--spacing-4);
					border-radius: var(--radius-lg);
					background: var(--color-fill);
				}

				html.nav-collapsed .mobile-nav__theme-label {
					font-size: var(--font-size-sm);
					font-weight: 500;
					color: var(--color-text-secondary);
				}

				html.nav-collapsed .mobile-nav__theme-row .theme-btn {
					width: 2rem;
					height: 2rem;
				}

				html.nav-collapsed .mobile-nav__theme-row .theme-btn svg {
					width: 16px;
					height: 16px;
				}

				html.nav-collapsed .mobile-nav__admin-btn {
					width: 100%;
					justify-content: center;
					min-height: 42px;
				}

			/* Tablet layout (641px - 820px): elegant anchored dropdown sheet */
			@media (min-width: 641px) {
				html.nav-collapsed .mobile-nav {
					inset-inline: auto 0;
					width: 380px;
					border-inline-start: 1px solid var(--color-border);
					border-bottom-left-radius: var(--radius-xl);
				}
			}

			@media (max-width: 560px) {
				.site-footer__grid {
					grid-template-columns: minmax(0, 1fr);
				}

				.brand__name {
					max-width: 9rem;
				}
			}
		</style>

		<script>
			// ⌘K / Ctrl+K focuses the header search
			const searchInput =
				document.querySelector<HTMLInputElement>(".site-search-input");
			const kbd = document.querySelector(".site-search__kbd span");
			if (kbd && !/Mac|iPhone|iPad|iPod/.test(navigator.platform)) {
				kbd.textContent = "Ctrl K";
			}
			document.addEventListener("keydown", (e) => {
				if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== "k") return;
				// The header search is hidden on small screens; leave the shortcut to the browser there
				if (!searchInput || searchInput.getClientRects().length === 0) return;
				e.preventDefault();
				searchInput.focus();
			});
		</script>
		<script>
			// Mobile Navigation Drawer Controller
			(function () {
				const toggleBtn = document.getElementById("mobile-menu-toggle");
				const drawer = document.getElementById("mobile-nav-drawer");
				const backdrop = document.getElementById("mobile-nav-backdrop");
				if (!toggleBtn || !drawer || !backdrop) return;

				const btn = toggleBtn;
				const drw = drawer;
				const bdp = backdrop;

				let isOpen = false;

				function setOpen(open: boolean) {
					isOpen = open;
					btn.setAttribute("aria-expanded", String(open));
					btn.setAttribute(
						"aria-label",
						(open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? "",
					);
					btn.classList.toggle("is-active", open);

					drw.classList.toggle("is-open", open);
					drw.setAttribute("aria-hidden", String(!open));

					bdp.classList.toggle("is-open", open);
					bdp.setAttribute("aria-hidden", String(!open));

					if (open) {
						document.body.style.overflow = "hidden";
					} else {
						document.body.style.overflow = "";
					}
				}

				btn.addEventListener("click", () => {
					setOpen(!isOpen);
				});

				bdp.addEventListener("click", () => {
					setOpen(false);
				});

				// Close on Escape key
				document.addEventListener("keydown", (e: KeyboardEvent) => {
					if (e.key === "Escape" && isOpen) {
						setOpen(false);
						toggleBtn.focus();
					}
				});

				// Close on clicking any navigation link
				drawer.querySelectorAll("a").forEach((link) => {
					link.addEventListener("click", () => {
						setOpen(false);
					});
				});

				// Close the drawer when the header stops being collapsed (viewport got wider)
				new MutationObserver(() => {
					if (isOpen && !document.documentElement.classList.contains("nav-collapsed")) {
						setOpen(false);
					}
				}).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
			})();
		</script>
		<script>
			// Visual-editing helpers are only useful to signed-in editors; keep
			// them out of the bundle every other visitor downloads.
			if (document.body.hasAttribute("data-emdash-editor")) {
				import("../scripts/inline-block-preview.ts");
			}
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
