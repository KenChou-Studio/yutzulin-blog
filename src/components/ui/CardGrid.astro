---
import InfoCard from "./InfoCard.astro";

interface Props {
	cols?: 1 | 2 | 3;
	gap?: string;
	class?: string;
	node?: any;
	value?: any;
	cards?: any[];
}

const props = Astro.props;
const data =
	props.node && typeof props.node === "object"
		? props.node
		: props.value && typeof props.value === "object"
			? props.value
			: props;

const cards: any[] = data.cards || props.cards || [];
const hasCards = Array.isArray(cards) && cards.length > 0;
const cardCount = cards.length;

// If 2 or 4 cards -> 2 cols; if 3, 5, 6 cards -> 3 cols
const cols = props.cols || data.cols || (cardCount === 2 || cardCount === 4 ? 2 : 3);
const className = props.class || "";
---

<div
	class={`card-grid card-grid--${cols} ${className}`}
	style={props.gap ? `--grid-gap: ${props.gap};` : undefined}
	data-emdash-block="card_grid"
>
	{hasCards ? (
		cards.map((card: any) => (
			<InfoCard node={card} />
		))
	) : (
		<slot />
	)}
</div>

<style>
	.card-grid {
		display: grid;
		gap: var(--grid-gap, 18px);
		margin-block: 28px;
		width: 100%;
	}

	.card-grid--2 {
		grid-template-columns: 1fr;
	}

	@media (min-width: 640px) {
		.card-grid--2 {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.card-grid--3 {
		grid-template-columns: 1fr;
	}

	@media (min-width: 640px) {
		.card-grid--3 {
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		}
	}

	@media (min-width: 980px) {
		.card-grid--3 {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
