---
/**
 * Home page body, shared by `/` and `/<locale>` so the locale-prefixed root
 * does not depend on how Astro ranks the `[...locale]` routes.
 */
import { getSiteSettings } from "emdash";
import { getEntryWithFallback } from "../i18n/fallback";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { getContentAlternates } from "../i18n/alternates";
import { getTranslator, type Locale } from "../i18n";
import { blockComponents } from "../plugins/site-blocks-components";
import { groupContentBlocks } from "../utils/group-blocks";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/prose.css";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

const [homeResult, settings] = await Promise.all([
	getEntryWithFallback("pages", "home", locale),
	getSiteSettings(),
]);

const homePage = homeResult?.entry;
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings, locale, await getTranslator(Astro, locale));
const alternates = homePage
	? await getContentAlternates("pages", homePage.data.id, () => "/")
	: undefined;

if (Astro.cache?.enabled) {
	if (homeResult?.cacheHint) Astro.cache.set(homeResult.cacheHint);
}

// The home page is its Content: the hero is a Hero block at the top of it.
const blocks = Array.isArray(homePage?.data?.content) ? homePage.data.content : [];
---

<Base
	title={siteTitle}
	description={homePage?.data?.excerpt || siteTagline}
	alternates={alternates}
	// No `content` ref: EmDashHead would build hreflang from the `/{slug}` pattern (`/home`),
	// but the home page is served at `/`. Base emits the correct hreflang links itself.
>
	{
		blocks.length > 0 && (
			<section class="band section">
				<div class="frame">
					<div class="home-body-content prose page-body" {...(homePage?.edit as any)?.content}>
						<PortableText
							value={groupContentBlocks(blocks)}
							components={{ type: blockComponents }}
						/>
					</div>
				</div>
			</section>
		)
	}
</Base>
