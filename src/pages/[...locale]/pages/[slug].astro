---
import { decodeSlug } from "emdash";
import { localePath, resolveRouteLocale } from "../../../i18n";

const locale = resolveRouteLocale(Astro.params.locale);
const slug = decodeSlug(Astro.params.slug);

if (!locale || !slug) {
	return Astro.rewrite("/404");
}

return Astro.redirect(localePath(locale, `/${slug}`), 308);
---
