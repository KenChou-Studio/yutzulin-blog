---
import { getTermsForEntries } from "emdash";
import { getEntriesWithFallback, pageOf } from "../../../i18n/fallback";
import { getTranslator, localePath, resolveRouteLocale } from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";

const locale = resolveRouteLocale(Astro.params.locale);
if (!locale) {
	return Astro.rewrite("/404");
}
const t = await getTranslator(Astro, locale);

// Posts in this language plus the ones that only exist in the other language
// (EmDash lists one locale at a time), paged in memory; `cursor` is the offset.
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: allPosts, cacheHints } = await getEntriesWithFallback("posts", locale);
const { page: posts, nextCursor } = pageOf(allPosts, cursor, 20);

if (Astro.cache?.enabled) for (const hint of cacheHints) Astro.cache.set(hint as never);

// Single batched query for tags across all posts, instead of one
// getEntryTerms() call per post (which would be N round-trips).
// Bylines are already hydrated on entry.data.bylines.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
	{ locale },
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title={t("posts.allTitle")} description={t("posts.description")}>
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">{t("posts.archive")}</p>
			<h1 class="intro__title">{t("posts.allTitle")}</h1>
			<p class="intro__lead">{t("posts.archiveLead")}</p>
		</div>
	</header>

	<section class="band section archive-band">
		<div class="frame">
			{
				posts.length === 0 ? (
					<div class="empty-state">
						<h2 class="empty-state__title">
							{cursor ? t("posts.noMore") : t("posts.none")}
						</h2>
						<p class="empty-state__text">
							{cursor ? t("posts.noMoreText") : t("posts.noneText")}
						</p>
						{cursor && (
							<div class="empty-state__actions">
								<a href={localePath(locale, "/posts")} class="btn btn--ghost">
									{t("posts.firstPage")}
								</a>
							</div>
						)}
					</div>
				) : (
					<>
						<ol class="archive__list">
							{postsWithTags.map(({ post, tags }) => (
								<li>
									<PostCard post={post} tags={tags} variant="row" locale={locale} />
								</li>
							))}
						</ol>
						<Pagination
							basePath={localePath(locale, "/posts")}
							locale={locale}
							cursor={cursor}
							nextCursor={nextCursor}
						/>
					</>
				)
			}
		</div>
	</section>
</Base>

<style>
	/* The band's rule doubles as the first row divider */
	.archive-band {
		padding-block-start: 0;
	}

	.archive__list {
		list-style: none;
	}

	.archive__list > li + li {
		border-block-start: 1px solid var(--color-border);
	}
</style>
