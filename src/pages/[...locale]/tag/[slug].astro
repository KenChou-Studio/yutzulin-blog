---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import { getTranslator, localePath, resolveRouteLocale } from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";

const locale = resolveRouteLocale(Astro.params.locale);
if (!locale) {
	return Astro.rewrite("/404");
}
const t = await getTranslator(Astro, locale);
const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	locale,
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	locale,
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

// Single batched query for tags on every post tagged with this term,
// rather than calling getEntryTerms() per post.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
	{ locale },
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).filter(
		(t) => t.slug !== term.slug,
	),
}));
---

<Base
	title={t("tag.title", { label: term.label })}
	description={t("tag.description", { label: term.label })}
>
	<header class="band intro">
		<div class="frame archive-intro">
			<div class="archive-intro__text">
				<p class="eyebrow">{t("tag.eyebrow")}</p>
				<h1 class="intro__title">{term.label}</h1>
				<p class="intro__lead">
					{term.description || t("tag.lead", { label: term.label })}
				</p>
			</div>
			<a href={localePath(locale, "/posts")} class="arrow-link">
				{t("posts.all")}
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14"></path>
					<path d="m12 5 7 7-7 7"></path>
				</svg>
			</a>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			{
				filteredPosts.length > 0 ? (
					<>
						<div class="post-grid">
							{filteredPosts.map(({ post, tags }) => (
								<PostCard
									post={post}
									locale={locale}
									tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
								/>
							))}
						</div>
						<Pagination
							basePath={localePath(locale, `/tag/${term.slug}`)}
							locale={locale}
							cursor={cursor}
							nextCursor={nextCursor}
						/>
					</>
				) : (
					<div class="empty-state">
						<h2 class="empty-state__title">
							{cursor ? t("posts.noMore") : t("archive.nothingYet")}
						</h2>
						<p class="empty-state__text">
							{cursor
								? t("pager.pastLast")
								: t("tag.empty", { label: term.label })}
						</p>
						<div class="empty-state__actions">
							<a
								href={
									cursor
										? localePath(locale, `/tag/${term.slug}`)
										: localePath(locale, "/posts")
								}
								class="btn btn--ghost"
							>
								{cursor ? t("pager.firstBack") : t("search.browseAll")}
							</a>
						</div>
					</div>
				)
			}
		</div>
	</section>
</Base>

<style>
	.archive-intro {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		align-items: last baseline;
		justify-content: space-between;
		gap: var(--spacing-5) var(--spacing-10);
	}

	.archive-intro__text {
		min-width: 0;
	}
</style>
