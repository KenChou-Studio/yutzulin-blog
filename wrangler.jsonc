{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yutzulin-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "yutzulin-blog-db",
			// From `wrangler d1 create yutzulin-blog-db --location=apac`. Not a secret.
			"database_id": "7aa18a51-e840-4baf-b46d-8992a79dd81b"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "yutzulin-blog-media"
			// Run `wrangler r2 bucket create yutzulin-blog-media` for remote deployment
		}
	],
	"observability": {
		"enabled": true
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger for scheduled posts & background jobs
	"triggers": {
		"crons": ["* * * * *"]
	}
}
